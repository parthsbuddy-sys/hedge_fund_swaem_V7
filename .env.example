# V7 Hedge Fund Swarm — .env
# Copy this to .env and fill in your keys

# === LLM Provider (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
V7_LLM_MODEL=moonshotai/kimi-k2.6
V7_REASONING_MODEL=moonshotai/kimi-k2.6
V7_TEMPERATURE=0.15

# === Delta Exchange (Testnet)
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org

# === Trading Config
V7_SYMBOLS=BTCUSD,ETHUSD,SOLUSD
V7_TICK_INTERVAL=10
V7_MAX_TRADES_PER_TICK=2

# === Memory
V7_MEMORY_PATH=memory/decisions.db

# === Engine
ENGINE_MODE=LIVE
